# Godot 4+ cache and internal editor data
.godot/
.nomedia

# Godot 3 old internal cache directory
.import/

# Game export configurations (can contain sensitive keys or machine-specific paths)
export.cfg
export_credentials.cfg

# Automatically generated translation files (compiled from your source CSVs)
*.translation

# Godot temporary/crash files
*.tmp
mono_crash.*.json

# Mono / C# specific builds and binaries (uncomment if using Godot C#)
# .mono/
# data_*/
